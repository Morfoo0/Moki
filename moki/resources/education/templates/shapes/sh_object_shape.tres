[resource]
script = ExtResource("1_tpl")
id = &"sh_object_shape"
title = "¿Qué forma tiene?"
stage = 2
instruction = "Mira {object}. ¿Qué forma tiene?"
hints = PackedStringArray("Fíjate en el borde de {object}. ¿A qué figura se parece?", "Pasa tu dedo por el borde de {object}: ¿tiene esquinas o es redondo?", "Si dibujaras {object} con una sola figura, ¿cuál usarías?", "Quité algunas figuras. Mira otra vez {object}.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_gen")
