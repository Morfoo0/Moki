[resource]
script = ExtResource("1_tpl")
id = &"sh_corners"
title = "Cuenta las esquinas"
stage = 3
instruction = "¿Cuántas {part} tiene este {name}?"
hints = PackedStringArray("Cuenta las {part} del {name}, una por una.", "Toca cada {part_one} con tu dedo mientras cuentas: uno, dos...", "Imagina una hormiguita que camina por el borde. Cada vez que gira, encuentra una esquina. ¿Cuántas veces gira?", "Quité algunos números. Cuenta otra vez, despacito.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_gen")
