[gd_resource type="Resource" script_class="ActivityTemplate" format=3]

[ext_resource type="Script" path="res://scripts/education/activity_template.gd" id="1_tpl"]
[ext_resource type="Script" path="res://scripts/education/generators/shape_generator.gd" id="2_gen"]

[sub_resource type="Resource" id="Resource_gen"]
script = ExtResource("2_gen")
mode = 6

[resource]
script = ExtResource("1_tpl")
id = &"sh_scene"
title = "Figuras escondidas"
view_type = 3
stage = 3
instruction = "¡Este dibujo es {scene} hecho de figuras! Encuentra todos los {plural}."
hints = PackedStringArray("Mira el dibujo con calma. ¿Dónde ves un {name}? Puede haber varios.", "{fact}", "{riddle}", "Quité algunas partes del dibujo. Compara con el {name} de aquí arriba.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_gen")
