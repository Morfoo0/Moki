[resource]
script = ExtResource("1_tpl")
id = &"sh_odd"
title = "¿Cuál es diferente?"
stage = 1
instruction = "Todas son {plural} menos una. ¿Cuál es diferente?"
hints = PackedStringArray("Aquí hay muchos {plural} de colores y tamaños distintos. Una figura es diferente: ¡búscala!", "{fact}", "{similar}", "Compara cada figura con el {name} de aquí arriba. Quité algunos {plural}.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_gen")
