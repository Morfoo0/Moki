title = "¿Qué vocal suena así?"
instruction = "Moki dice «{sound}». ¿Qué vocal suena así?"
hints = PackedStringArray("Di «{sound}» tú también, despacito. ¿Qué vocal hace ese sonido?", "Fíjate en cómo se pone tu boca al decir «{sound}».", "Di las vocales en orden: a, e, i, o, u. ¿Cuál suena igual que «{sound}»?", "Quité algunas vocales. Di «{sound}» otra vez y mira las que quedan.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_gen")
