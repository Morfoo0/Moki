[resource]
script = ExtResource("1_tpl")
id = &"cb_compare_shapes"
title = "¿Dónde hay más figuras?"
stage = 2
instruction = "¿Dónde hay {more_less} {plural}?"
hints = PackedStringArray("Mira solo los {plural} de cada grupo. Las otras figuras no cuentan.", "Cuenta los {plural} de un grupo y luego los del otro.", "{fact} ¿En qué grupo hay {more_less} figuras así?", "Cuenta otra vez los {plural} de cada grupo con tu dedo.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_gen")
