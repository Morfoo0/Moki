[resource]
script = ExtResource("1_tpl")
id = &"num_count_tap"
title = "Toca y cuenta"
view_type = 1
stage = 2
instruction = "Toca {number} {object_n}. ¡Yo cuento contigo!"
hints = PackedStringArray("Toca solo {name}: ni más, ni menos.", "Cada vez que tocas uno, yo cuento. Para cuando lleguemos a {name}.", "Levanta {fingers}. Toca un dibujo por cada dedo.", "Mira cuántos llevas y cuenta conmigo, despacito.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_gen")
