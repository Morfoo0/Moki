[resource]
script = ExtResource("1_tpl")
id = &"num_compare"
title = "¿Dónde hay más?"
stage = 2
instruction = "¿Dónde hay {more_less} {object}?"
hints = PackedStringArray("Mira los grupos. ¿Cuál tiene {more_less}?", "Cuenta cada grupo. El que tiene {more_less} dice un número {bigger_smaller}.", "Si fueran galletas para ti, ¿qué grupo te daría {more_less}?", "Cuenta cada grupo con tu dedo, despacito.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_gen")
