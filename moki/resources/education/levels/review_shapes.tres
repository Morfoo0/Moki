[sub_resource type="Resource" id="Resource_review_shapes_1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. Hoy repasaremos las figuras: círculo, cuadrado, triángulo, rectángulo y óvalo."
kind = 1

[sub_resource type="Resource" id="Resource_review_shapes_2"]
script = ExtResource("2_line")
text = "Recuerda: el cuadrado tiene sus 4 lados iguales y el rectángulo, 2 largos y 2 cortos. El óvalo es un círculo estirado."
kind = 1

[sub_resource type="Resource" id="Resource_review_shapes_3"]
script = ExtResource("2_line")
text = "Fíjate en la forma, no en el color ni en el tamaño. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_review_shapes_4"]
script = ExtResource("2_line")
text = "¡Muy bien! Repasaste las cinco figuras. Cuando quieras, te espera el repaso combinado."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_review_shapes_5"]
script = ExtResource("2_line")
text = "¡Qué buen observador eres! ¿Vamos después a mezclar letras, números y figuras?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_review_shapes_6"]
script = ExtResource("2_line")
text = "¡Bravo! Las figuras siguen siendo tus amigas. ¡El repaso combinado te espera!"
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"review_shapes"
title = "Repaso de figuras"
objective = "Reforzar las cinco figuras: reconocerlas en distintos tamaños y giros, diferenciar círculo y óvalo y cuadrado y rectángulo, relacionarlas con objetos, encontrarlas en dibujos y clasificar, con más práctica para las que más la necesitan."
concept_ids = Array[StringName]([&"review_shapes"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_review_shapes_1"), SubResource("Resource_review_shapes_2"), SubResource("Resource_review_shapes_3")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_review_shapes_4"), SubResource("Resource_review_shapes_5"), SubResource("Resource_review_shapes_6")])
reinforce_lines = PackedStringArray("¡Te fijaste en la forma!", "¡Lo recordaste muy bien!", "¡Practicar te hace crecer!")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_sh_pick"), ExtResource("t_sh_match"), ExtResource("t_sh_grid"), ExtResource("t_sh_odd"), ExtResource("t_sh_twins"), ExtResource("t_sh_object"), ExtResource("t_sh_object_shape"), ExtResource("t_sh_find_objects"), ExtResource("t_sh_scene"), ExtResource("t_sh_corners"), ExtResource("t_sh_sort_objects"), ExtResource("t_sh_sort_shapes")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"review_mixed"])
