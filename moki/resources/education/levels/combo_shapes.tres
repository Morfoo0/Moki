[sub_resource type="Resource" id="Resource_combo_shapes_1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. Hoy juntaremos las figuras con los números."
kind = 1

[sub_resource type="Resource" id="Resource_combo_shapes_2"]
script = ExtResource("2_line")
text = "Primero buscarás una figura, por ejemplo los círculos, y después contarás cuántos hay."
kind = 1

[sub_resource type="Resource" id="Resource_combo_shapes_3"]
script = ExtResource("2_line")
text = "¡Mira a tu alrededor! Una ventana es un cuadrado y las ruedas de un coche son círculos. ¿Cuántas ruedas tiene un coche?"
kind = 2
mood = 2

[sub_resource type="Resource" id="Resource_combo_shapes_4"]
script = ExtResource("2_line")
text = "Cuenta solo la figura que te pido: las otras no cuentan. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_combo_shapes_5"]
script = ExtResource("2_line")
text = "¡Muy bien! Encontraste figuras y las contaste. Cuando quieras, te esperan los retos combinados."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_combo_shapes_6"]
script = ExtResource("2_line")
text = "¡Qué buen observador eres! Figuras y números juntos. ¿Vamos después con los retos?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_combo_shapes_7"]
script = ExtResource("2_line")
text = "¡Bravo! Contaste círculos, cuadrados y triángulos. ¡Los retos combinados te esperan!"
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"combo_shapes"
title = "Figuras y cantidades"
objective = "Combinar figuras y números: reconocer y clasificar las cinco figuras, contar cuántas hay de una figura entre otras, contarlas en dibujos y comparar conjuntos."
concept_ids = Array[StringName]([&"combo_shapes"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_combo_shapes_1"), SubResource("Resource_combo_shapes_2"), SubResource("Resource_combo_shapes_3"), SubResource("Resource_combo_shapes_4")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_combo_shapes_5"), SubResource("Resource_combo_shapes_6"), SubResource("Resource_combo_shapes_7")])
reinforce_lines = PackedStringArray("¡Buscaste la figura y la contaste!", "¡Figuras y números juntos!", "¡Solo contaste la figura que tocaba!")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_sh_pick"), ExtResource("t_sh_match"), ExtResource("t_sh_grid"), ExtResource("t_sh_odd"), ExtResource("t_sh_twins"), ExtResource("t_cb_count_shapes"), ExtResource("t_cb_compare_shapes"), ExtResource("t_cb_tap_n_shapes"), ExtResource("t_cb_scene_count"), ExtResource("t_sh_corners"), ExtResource("t_sh_sort_shapes"), ExtResource("t_cb_sort_round")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"combo_mixed"])
