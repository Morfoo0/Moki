[sub_resource type="Resource" id="Resource_i1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. Hoy vamos a conocer a la letra I."
kind = 1

[sub_resource type="Resource" id="Resource_i2"]
script = ExtResource("2_line")
text = "La I suena «iii», como un ratoncito. Estira la boca conmigo: iii."
spoken = "La I suena iiii, como un ratoncito. Estira la boca conmigo: iii."
kind = 1
mood = 2

[sub_resource type="Resource" id="Resource_i3"]
script = ExtResource("2_line")
text = "La I grande es un palito derechito. La i pequeñita lleva un puntito encima, como un sombrerito."
kind = 1

[sub_resource type="Resource" id="Resource_i4"]
script = ExtResource("2_line")
text = "Yo te digo qué hacer y tú tocas la respuesta. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_i5"]
script = ExtResource("2_line")
text = "La I está en muchas cosas: en la isla del mar, en el imán del refrigerador y en el iglú de nieve."
kind = 2

[sub_resource type="Resource" id="Resource_i6"]
script = ExtResource("2_line")
text = "¡Lo hiciste genial! Ya conoces mejor a la letra I. Cuando quieras, te espera la letra O."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_i7"]
script = ExtResource("2_line")
text = "¡Qué bien aprendes! La I ya es tu amiga. ¡La O tiene muchas ganas de conocerte!"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_i8"]
script = ExtResource("2_line")
text = "¡Bravo! Hoy practicaste mucho con la letra I. ¿Vamos después con la O?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_i9"]
script = ExtResource("5_choice")

[sub_resource type="Resource" id="Resource_i10"]
script = ExtResource("4_tpl")
id = &"i_pick"
title = "Toca la I"
instruction = "Toca la letra I."
hints = PackedStringArray("Busca la letra que suena «iii», como cuando estiras la boca como un ratoncito.", "La I es un palito derechito, muy derechito.", "Adivina, adivinanza: soy flaquita y derechita, como un palito. ¿Quién soy?", "Mira la I grande que te muestro aquí arriba. Quité algunas letras: busca una igual.")
hints_spoken = PackedStringArray("Busca la letra que suena iiii, como cuando estiras la boca como un ratoncito.")
generator = SubResource("Resource_i9")

[sub_resource type="Resource" id="Resource_i11"]
script = ExtResource("5_choice")
mode = 4

[sub_resource type="Resource" id="Resource_i12"]
script = ExtResource("4_tpl")
id = &"i_sound"
title = "¿Qué vocal suena así?"
instruction = "Moki dice «iii». ¿Qué vocal suena así?"
instruction_spoken = "Moki dice iiii. ¿Qué vocal suena así?"
hints = PackedStringArray("Di «iii» tú también, despacito. ¿Qué vocal hace ese sonido?", "Para decir «iii» estiras la boca como un ratoncito. ¿Qué vocal se dice así?", "Los ratoncitos dicen «iii». ¿Qué vocal suena como un ratoncito?", "Quité algunas vocales. Di «iii» otra vez y mira las que quedan.")
hints_spoken = PackedStringArray("Di iiii tú también, despacito. ¿Qué vocal hace ese sonido?", "Para decir iiii estiras la boca como un ratoncito. ¿Qué vocal se dice así?", "Los ratoncitos dicen iiii. ¿Qué vocal suena como un ratoncito?", "Quité algunas vocales. Di iiii otra vez y mira las que quedan.")
generator = SubResource("Resource_i11")

[sub_resource type="Resource" id="Resource_i13"]
script = ExtResource("6_search")

[sub_resource type="Resource" id="Resource_i14"]
script = ExtResource("4_tpl")
id = &"i_grid"
title = "Busca todas las I"
view_type = 1
stage = 1
instruction = "Busca todas las I y tócalas una por una."
hints = PackedStringArray("Toca cada letra I que veas. ¡Puede haber varias!", "Fíjate en las letras que son un palito derechito.", "La T también tiene un palito, pero lleva encima un techo largo, como una mesa. ¿Cuáles son solo un palito?", "Compara cada letra con la I de aquí arriba. Quité algunas para que sea más fácil.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_i13")

[sub_resource type="Resource" id="Resource_i15"]
script = ExtResource("5_choice")
