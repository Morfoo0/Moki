[resource]
script = ExtResource("3_level")
id = &"letters_i"
title = "La letra I"
objective = "Reconocer la vocal I (mayúscula y minúscula), distinguirla de otras letras, identificar su sonido «iii», asociarla con palabras que empiezan con I y encontrarla en distintos contextos."
concept_ids = Array[StringName]([&"letter_i"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_i1"), SubResource("Resource_i2"), SubResource("Resource_i3"), SubResource("Resource_i4"), SubResource("Resource_i5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_i6"), SubResource("Resource_i7"), SubResource("Resource_i8")])
reinforce_lines = PackedStringArray("La I suena «iii», como un ratoncito.", "La i pequeñita lleva su puntito.", "La I es derechita, como un palito.")
templates = Array[ExtResource("4_tpl")]([SubResource("Resource_i10"), SubResource("Resource_i12"), SubResource("Resource_i14"), SubResource("Resource_i16"), SubResource("Resource_i18"), SubResource("Resource_i20"), SubResource("Resource_i22"), SubResource("Resource_i24"), SubResource("Resource_i26"), SubResource("Resource_i28"), SubResource("Resource_i30"), SubResource("Resource_i32")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"letters_o"])
