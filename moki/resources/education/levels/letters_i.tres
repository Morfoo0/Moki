[sub_resource type="Resource" id="Resource_i20"]
script = ExtResource("4_tpl")
id = &"i_initial"
title = "¿Con qué letra empieza?"
stage = 2
instruction = "{this_is} {article} {word}. ¿Con qué letra empieza {word}?"
hints = PackedStringArray("Di «{word}» despacito. ¿Qué sonido escuchas primero?", "El primer sonido de «{word}» es el mismo que el de «iglú».", "Para decir ese primer sonido estiras la boca como un ratoncito. ¿Qué letra hace ese sonido?", "Quité algunas letras para que sea más fácil. Di «{word}» otra vez, despacito.")
hints_spoken = PackedStringArray("Di {word} despacito. ¿Qué sonido escuchas primero?", "El primer sonido de {word} es el mismo que el de iglú.", "", "Quité algunas letras para que sea más fácil. Di {word} otra vez, despacito.")
