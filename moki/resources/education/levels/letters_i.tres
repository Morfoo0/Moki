[sub_resource type="Resource" id="Resource_i16"]
script = ExtResource("4_tpl")
id = &"i_odd"
title = "¿Cuál no es I?"
stage = 1
instruction = "Todas son I menos una. ¿Cuál NO es una I?"
hints = PackedStringArray("Aquí hay muchas I vestidas de distinta forma. Una letra es diferente: ¡búscala!", "Mira cada letra: la I es solo un palito derechito, sin brazos ni curvas.", "Si todas fueran lápices, ¿cuál no estaría derechito?", "Compara cada letra con la I de aquí arriba. Quité algunas I para que sea más fácil.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_i15")

