[sub_resource type="Resource" id="Resource_i22"]
script = ExtResource("4_tpl")
id = &"i_disguised"
title = "La I disfrazada"
stage = 3
difficulty_min = 2
instruction = "Las letras se disfrazaron con otros colores y formas. ¿Puedes encontrar {letter_name}?"
hints = PackedStringArray("Aunque cambie de color o de tamaño, la I sigue siendo la I. ¡Y la i pequeñita también es I!", "No te fijes en el color: fíjate en su forma.", "Si te pones un gorro sigues siendo tú. ¿Qué letra sigue siendo la I aunque esté disfrazada?", "Mira la letra de aquí arriba y busca la que tiene su misma forma.")
hints_spoken = PackedStringArray()
