title = "¿Qué dibujo empieza con I?"
stage = 2
instruction = "¿Qué dibujo empieza con I?"
hints = PackedStringArray("Di el nombre de cada dibujo despacito. ¿Cuál empieza con «iii»?", "Escucha solo el primer sonido de cada palabra.", "«Iglú» empieza con I. ¿Qué dibujo empieza igual que iglú?", "Quité algunos dibujos. Mira la I de aquí arriba y di cada nombre despacito.")
hints_spoken = PackedStringArray("Di el nombre de cada dibujo despacito. ¿Cuál empieza con iiii?", "", "Iglú empieza con I. ¿Qué dibujo empieza igual que iglú?")
