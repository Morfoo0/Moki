[sub_resource type="Resource" id="Resource_review_challenge_1"]
script = ExtResource("2_line")
text = "¡Hola, gran explorador! Soy Moki y hoy es el gran desafío final."
kind = 1
mood = 2

[sub_resource type="Resource" id="Resource_review_challenge_2"]
script = ExtResource("2_line")
text = "Te preparé una aventura con un poco de todo lo que aprendiste: letras, números y figuras."
kind = 1

[sub_resource type="Resource" id="Resource_review_challenge_3"]
script = ExtResource("2_line")
text = "No hay prisa ni notas: solo vamos a divertirnos aprendiendo. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_review_challenge_4"]
script = ExtResource("2_line")
text = "¡Lo lograste! Recorriste todos los mundos de Moki: letras, números y figuras. ¡Aprendiste muchísimo!"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_review_challenge_5"]
script = ExtResource("2_line")
text = "¡Estoy muy orgulloso de ti! Puedes volver a cualquier mundo cuando quieras para seguir jugando y aprendiendo."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_review_challenge_6"]
script = ExtResource("2_line")
text = "¡Bravo, gran explorador! Gracias por aprender conmigo. ¡Siempre hay nuevos retos esperándote!"
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"review_challenge"
title = "El gran desafío de Moki"
objective = "Consolidar todo lo aprendido en Moki (vocales, números, cantidades y figuras) en una aventura final que se construye con el desempeño del niño: más práctica en lo que cuesta, mantenimiento de lo dominado y retos mayores si todo va bien."
concept_ids = Array[StringName]([&"review_challenge"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_review_challenge_1"), SubResource("Resource_review_challenge_2"), SubResource("Resource_review_challenge_3")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_review_challenge_4"), SubResource("Resource_review_challenge_5"), SubResource("Resource_review_challenge_6")])
reinforce_lines = PackedStringArray("¡Una parada más de la aventura!", "¡Usaste todo lo que sabes!", "¡Qué gran explorador!")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_cb_vowel_sound"), ExtResource("t_num_match"), ExtResource("t_sh_pick"), ExtResource("t_cb_vowel_grid"), ExtResource("t_sh_twins"), ExtResource("t_num_grid"), ExtResource("t_cb_vowel_initial"), ExtResource("t_num_count"), ExtResource("t_cb_vowel_count"), ExtResource("t_cb_count_shapes"), ExtResource("t_num_compare"), ExtResource("t_cb_scene_count"), ExtResource("t_num_sequence"), ExtResource("t_cb_corners_shape"), ExtResource("t_cb_word_vowel"), ExtResource("t_cb_sort_symbols3"), ExtResource("t_cb_sort_vowels"), ExtResource("t_sh_sort_objects")])
content = ExtResource("1_bank")
