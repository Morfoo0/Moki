[sub_resource type="Resource" id="Resource_combo_mixed_1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. Hoy hay retos especiales: en cada uno usarás dos cosas que ya sabes."
kind = 1

[sub_resource type="Resource" id="Resource_combo_mixed_2"]
script = ExtResource("2_line")
text = "Por ejemplo: buscar los dibujos que empiezan con la A y contar cuántos hay. ¡Letras y números a la vez!"
kind = 1
mood = 2

[sub_resource type="Resource" id="Resource_combo_mixed_3"]
script = ExtResource("2_line")
text = "En casa también pasa: cuentas los platos de la mesa o buscas tu nombre en una puerta."
kind = 2

[sub_resource type="Resource" id="Resource_combo_mixed_4"]
script = ExtResource("2_line")
text = "Escucha bien cada reto y piensa paso a paso. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_combo_mixed_5"]
script = ExtResource("2_line")
text = "¡Increíble! Usaste letras, números y figuras a la vez. Cuando quieras, te espera el gran desafío."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_combo_mixed_6"]
script = ExtResource("2_line")
text = "¡Qué bien piensas! Resolviste retos de dos pasos. ¿Vamos después con el gran desafío de Moki?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_combo_mixed_7"]
script = ExtResource("2_line")
text = "¡Bravo! Ya estás listo para la última aventura."
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"combo_mixed"
title = "Retos combinados"
objective = "Usar dos conocimientos en el mismo reto: contar dibujos que empiezan con una vocal, tocar un número de letras, contar figuras, relacionar figuras y esquinas, y distinguir letras de números."
concept_ids = Array[StringName]([&"combo_mixed"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_combo_mixed_1"), SubResource("Resource_combo_mixed_2"), SubResource("Resource_combo_mixed_3"), SubResource("Resource_combo_mixed_4")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_combo_mixed_5"), SubResource("Resource_combo_mixed_6"), SubResource("Resource_combo_mixed_7")])
reinforce_lines = PackedStringArray("¡Usaste dos cosas que sabes a la vez!", "¡Pensaste paso a paso!", "¡Letras, números y figuras juntos!")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_cb_vowel_pick"), ExtResource("t_num_name"), ExtResource("t_cb_vowel_grid"), ExtResource("t_sh_odd"), ExtResource("t_cb_vowel_count"), ExtResource("t_cb_count_shapes"), ExtResource("t_cb_tap_n_vowel"), ExtResource("t_cb_scene_count"), ExtResource("t_cb_corners_shape"), ExtResource("t_cb_sort_symbols"), ExtResource("t_cb_sort_round")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"combo_challenge"])
