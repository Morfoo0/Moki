[sub_resource type="Resource" id="Resource_o32"]
script = ExtResource("4_tpl")
id = &"o_mixed"
title = "Grandes y pequeñitas"
view_type = 1
stage = 4
instruction = "Busca todas las O, grandes y pequeñitas, y tócalas."
hints = PackedStringArray("Toca cada O grande y cada o pequeñita. ¡Hay de las dos!", "La O grande y la o pequeñita tienen la misma forma: las dos son redondas. Solo cambia el tamaño.", "La c pequeñita es redonda pero está abierta, y la a lleva una colita. ¿Cuáles son redonditas y cerradas?", "Mira la O de aquí arriba. Recuerda que la o pequeñita también cuenta.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_o31")

[resource]
script = ExtResource("3_level")
id = &"letters_o"
title = "La letra O"
objective = "Reconocer la vocal O (mayúscula y minúscula), distinguirla de otras letras, identificar su sonido «ooo», asociarla con palabras que empiezan con O y encontrarla en distintos contextos."
concept_ids = Array[StringName]([&"letter_o"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_o1"), SubResource("Resource_o2"), SubResource("Resource_o3"), SubResource("Resource_o4"), SubResource("Resource_o5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_o6"), SubResource("Resource_o7"), SubResource("Resource_o8")])
reinforce_lines = PackedStringArray("La O suena «ooo».", "La O es redonda, como una pelota.", "Con la O la boca se pone redonda.")
templates = Array[ExtResource("4_tpl")]([SubResource("Resource_o10"), SubResource("Resource_o12"), SubResource("Resource_o14"), SubResource("Resource_o16"), SubResource("Resource_o18"), SubResource("Resource_o20"), SubResource("Resource_o22"), SubResource("Resource_o24"), SubResource("Resource_o26"), SubResource("Resource_o28"), SubResource("Resource_o30"), SubResource("Resource_o32")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"letters_u"])
