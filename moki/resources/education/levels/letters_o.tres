[sub_resource type="Resource" id="Resource_o30"]
script = ExtResource("4_tpl")
id = &"o_sort"
title = "Cesta de la O"
view_type = 2
stage = 4
instruction = "Pon en la cesta de la O los dibujos que empiezan con O. Los demás, en la otra cesta."
hints = PackedStringArray("Di el nombre de cada dibujo. Si empieza con «ooo», va con la O.", "Escucha solo el primer sonido de cada palabra.", "«Olla» empieza con O, «silla» no. ¿Qué dibujos suenan como olla al principio?", "Mira la O de la cesta y di cada nombre despacito.")
hints_spoken = PackedStringArray("Di el nombre de cada dibujo. Si empieza con oooo, va con la O.", "", "Olla empieza con O, silla no. ¿Qué dibujos suenan como olla al principio?")
generator = SubResource("Resource_o29")

