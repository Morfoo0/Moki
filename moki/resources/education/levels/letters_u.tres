title = "Cesta de la U"
view_type = 2
stage = 4
instruction = "Pon en la cesta de la U los dibujos que empiezan con U. Los demás, en la otra cesta."
hints = PackedStringArray("Di el nombre de cada dibujo. Si empieza con «uuu», va con la U.", "Escucha solo el primer sonido de cada palabra.", "«Uña» empieza con U, «mesa» no. ¿Qué dibujos suenan como uña al principio?", "Mira la U de la cesta y di cada nombre despacito.")
hints_spoken = PackedStringArray("Di el nombre de cada dibujo. Si empieza con uuuu, va con la U.", "", "Uña empieza con U, mesa no. ¿Qué dibujos suenan como uña al principio?")
