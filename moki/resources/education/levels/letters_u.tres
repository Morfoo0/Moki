[sub_resource type="Resource" id="Resource_u32"]
script = ExtResource("4_tpl")
id = &"u_mixed"
title = "Grandes y pequeñitas"
view_type = 1
stage = 4
instruction = "Busca todas las U, grandes y pequeñitas, y tócalas."
hints = PackedStringArray("Toca cada U grande y cada u pequeñita. ¡Hay de las dos!", "La U grande y la u pequeñita tienen la misma forma de vasito; la pequeñita a veces lleva una colita.", "La n pequeñita es como una u de cabeza: está abierta por abajo. ¿Cuáles están abiertas por arriba?", "Mira la U de aquí arriba. Recuerda que la u pequeñita también cuenta.")
