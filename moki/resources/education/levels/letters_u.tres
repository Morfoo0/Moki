script = ExtResource("4_tpl")
id = &"u_hidden"
title = "La U escondida"
view_type = 1
stage = 3
instruction = "¡La letra U se escondió entre los juguetes! Encuentra todas las U."
hints = PackedStringArray("Busca entre los dibujos una letra que sea U.", "La U tiene forma de vasito: abierta arriba y redondita abajo.", "Soy una letra con forma de vasito y me escondí entre los juguetes. ¿Me ves?", "Quité algunas cosas para que sea más fácil. Compara con la U de aquí arriba.")
hints_spoken = PackedStringArray()
