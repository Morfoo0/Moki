[resource]
script = ExtResource("3_level")
id = &"letters_u"
title = "La letra U"
objective = "Reconocer la vocal U (mayúscula y minúscula), distinguirla de otras letras, identificar su sonido «uuu», asociarla con palabras que empiezan con U, encontrarla en distintos contextos y completar las cinco vocales."
concept_ids = Array[StringName]([&"letter_u"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_u1"), SubResource("Resource_u2"), SubResource("Resource_u3"), SubResource("Resource_u4"), SubResource("Resource_u5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_u6"), SubResource("Resource_u7"), SubResource("Resource_u8")])
reinforce_lines = PackedStringArray("La U suena «uuu», como el búho.", "La U parece un vasito.", "Con la U la boquita se pone de beso.")
templates = Array[ExtResource("4_tpl")]([SubResource("Resource_u10"), SubResource("Resource_u12"), SubResource("Resource_u14"), SubResource("Resource_u16"), SubResource("Resource_u18"), SubResource("Resource_u20"), SubResource("Resource_u22"), SubResource("Resource_u24"), SubResource("Resource_u26"), SubResource("Resource_u28"), SubResource("Resource_u30"), SubResource("Resource_u32")])
content = ExtResource("1_bank")
