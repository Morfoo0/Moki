[sub_resource type="Resource" id="Resource_u1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. Hoy conocerás a la última vocal: la letra U."
kind = 1

[sub_resource type="Resource" id="Resource_u2"]
script = ExtResource("2_line")
text = "La U suena «uuu», como el búho por la noche. Pon la boquita como para dar un beso: uuu."
spoken = "La U suena uuuu, como el búho por la noche. Pon la boquita como para dar un beso: uuu."
kind = 1
mood = 2

[sub_resource type="Resource" id="Resource_u3"]
script = ExtResource("2_line")
text = "La U tiene forma de vasito: abierta arriba y redondita abajo. La u pequeñita es casi igual."
kind = 1

[sub_resource type="Resource" id="Resource_u4"]
script = ExtResource("2_line")
text = "Yo te digo qué hacer y tú tocas la respuesta. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_u5"]
script = ExtResource("2_line")
text = "La U está en muchas cosas: en las uvas que comes, en el número uno y en el unicornio de los cuentos."
kind = 2

[sub_resource type="Resource" id="Resource_u6"]
script = ExtResource("2_line")
text = "¡Lo lograste! Ya conoces la U... ¡y las cinco vocales: A, E, I, O, U!"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_u7"]
script = ExtResource("2_line")
text = "¡Qué orgulloso estoy de ti! La U ya es tu amiga. ¡Ya conoces todas las vocales!"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_u8"]
script = ExtResource("2_line")
text = "¡Bravo! Practicaste mucho con la U. Puedes volver a jugar con cualquier vocal cuando quieras."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_u9"]
script = ExtResource("5_choice")

[sub_resource type="Resource" id="Resource_u10"]
script = ExtResource("4_tpl")
id = &"u_pick"
title = "Toca la U"
instruction = "Toca la letra U."
hints = PackedStringArray("Busca la letra que suena «uuu», como cuando pones la boca chiquita, como para dar un beso.", "La U tiene forma de vasito: abierta arriba y redondita abajo.", "Adivina, adivinanza: parezco un vasito, abierta por arriba y redondita por abajo. ¿Quién soy?", "Mira la U grande que te muestro aquí arriba. Quité algunas letras: busca una igual.")
hints_spoken = PackedStringArray("Busca la letra que suena uuuu, como cuando pones la boca chiquita, como para dar un beso.")
generator = SubResource("Resource_u9")

[sub_resource type="Resource" id="Resource_u11"]
script = ExtResource("5_choice")
mode = 4

[sub_resource type="Resource" id="Resource_u12"]
script = ExtResource("4_tpl")
id = &"u_sound"
title = "¿Qué vocal suena así?"
instruction = "Moki dice «uuu». ¿Qué vocal suena así?"
instruction_spoken = "Moki dice uuuu. ¿Qué vocal suena así?"
hints = PackedStringArray("Di «uuu» tú también, despacito. ¿Qué vocal hace ese sonido?", "Para decir «uuu» pones la boca chiquita, como para dar un beso. ¿Qué vocal se dice así?", "El búho canta «uuu, uuu» por la noche. ¿Qué vocal suena como el búho?", "Quité algunas vocales. Di «uuu» otra vez y mira las que quedan.")
hints_spoken = PackedStringArray("Di uuuu tú también, despacito. ¿Qué vocal hace ese sonido?", "Para decir uuuu pones la boca chiquita, como para dar un beso. ¿Qué vocal se dice así?", "El búho canta uuu, uuu por la noche. ¿Qué vocal suena como el búho?", "Quité algunas vocales. Di uuuu otra vez y mira las que quedan.")
generator = SubResource("Resource_u11")

[sub_resource type="Resource" id="Resource_u13"]
script = ExtResource("6_search")

[sub_resource type="Resource" id="Resource_u14"]
script = ExtResource("4_tpl")
id = &"u_grid"
title = "Busca todas las U"
view_type = 1
stage = 1
instruction = "Busca todas las U y tócalas una por una."
hints = PackedStringArray("Toca cada letra U que veas. ¡Puede haber varias!", "Fíjate en las letras con forma de vasito.", "La V también está abierta arriba, pero abajo tiene pico. ¿Cuáles son redonditas abajo?", "Compara cada letra con la U de aquí arriba. Quité algunas para que sea más fácil.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_u13")

[sub_resource type="Resource" id="Resource_u15"]
script = ExtResource("5_choice")
mode = 1

[sub_resource type="Resource" id="Resource_u16"]
script = ExtResource("4_tpl")
id = &"u_odd"
title = "¿Cuál no es U?"
stage = 1
instruction = "Todas son U menos una. ¿Cuál NO es una U?"
hints = PackedStringArray("Aquí hay muchas U vestidas de distinta forma. Una letra es diferente: ¡búscala!", "Mira la parte de abajo de cada letra: la U es redondita, como un vasito.", "Si todas fueran vasitos, ¿en cuál no podrías echar agua?", "Compara cada letra con la U de aquí arriba. Quité algunas U para que sea más fácil.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_u15")

[sub_resource type="Resource" id="Resource_u17"]
script = ExtResource("7_wordimg")

[sub_resource type="Resource" id="Resource_u18"]
script = ExtResource("4_tpl")
id = &"u_pick_image"
title = "¿Qué dibujo empieza con U?"
stage = 2
instruction = "¿Qué dibujo empieza con U?"
hints = PackedStringArray("Di el nombre de cada dibujo despacito. ¿Cuál empieza con «uuu»?", "Escucha solo el primer sonido de cada palabra.", "«Uña» empieza con U. ¿Qué dibujo empieza igual que uña?", "Quité algunos dibujos. Mira la U de aquí arriba y di cada nombre despacito.")
hints_spoken = PackedStringArray("Di el nombre de cada dibujo despacito. ¿Cuál empieza con uuuu?", "", "Uña empieza con U. ¿Qué dibujo empieza igual que uña?")
generator = SubResource("Resource_u17")

[sub_resource type="Resource" id="Resource_u19"]
script = ExtResource("7_wordimg")
mode = 1

[sub_resource type="Resource" id="Resource_u20"]
script = ExtResource("4_tpl")
id = &"u_initial"
title = "¿Con qué letra empieza?"
stage = 2
instruction = "{this_is} {article} {word}. ¿Con qué letra empieza {word}?"
hints = PackedStringArray("Di «{word}» despacito. ¿Qué sonido escuchas primero?", "El primer sonido de «{word}» es el mismo que el de «uña».", "Para decir ese primer sonido pones la boca chiquita, como para dar un beso. ¿Qué letra hace ese sonido?", "Quité algunas letras para que sea más fácil. Di «{word}» otra vez, despacito.")
hints_spoken = PackedStringArray("Di {word} despacito. ¿Qué sonido escuchas primero?", "El primer sonido de {word} es el mismo que el de uña.", "", "Quité algunas letras para que sea más fácil. Di {word} otra vez, despacito.")
generator = SubResource("Resource_u19")

[sub_resource type="Resource" id="Resource_u21"]
script = ExtResource("5_choice")
mode = 2

[sub_resource type="Resource" id="Resource_u22"]
script = ExtResource("4_tpl")
id = &"u_disguised"
title = "La U disfrazada"
stage = 3
difficulty_min = 2
instruction = "Las letras se disfrazaron con otros colores y formas. ¿Puedes encontrar {letter_name}?"
hints = PackedStringArray("Aunque cambie de color o de tamaño, la U sigue siendo la U. ¡Y la u pequeñita también es U!", "No te fijes en el color: fíjate en su forma.", "Si te pones un bigote sigues siendo tú. ¿Qué letra sigue siendo la U aunque esté disfrazada?", "Mira la letra de aquí arriba y busca la que tiene su misma forma.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_u21")

