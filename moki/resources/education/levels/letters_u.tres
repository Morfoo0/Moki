title = "Grande y pequeñita"
stage = 3
instruction = "Esta es la {shown}. ¿Dónde está su pareja {pair}?"
hints = PackedStringArray("Cada letra tiene una forma grande y una pequeñita. Busca la pareja {pair} de la {shown}.", "La U grande y la u pequeñita tienen la misma forma de vasito; la pequeñita a veces lleva una colita.", "La grande y la pequeñita son como mamá y bebé: se llaman igual y suenan igual, «uuu». ¿Cuál es su pareja?", "Quité algunas letras. ¿Cuál de las que quedan suena «uuu»?")
hints_spoken = PackedStringArray("", "", "La grande y la pequeñita son como mamá y bebé: se llaman igual y suenan igual, uuuu. ¿Cuál es su pareja?", "Quité algunas letras. ¿Cuál de las que quedan suena uuuu?")
