[sub_resource type="Resource" id="Resource_u24"]
script = ExtResource("4_tpl")
id = &"u_word"
title = "Las U de la palabra"
view_type = 1
stage = 3
instruction = "Esta palabra es {word}. Toca todas las U que tiene."
hints = PackedStringArray("Mira las letras de la palabra una por una y toca las U.", "Busca las letras con forma de vasito.", "Cuando dices la palabra, en cada U la boca se pone chiquita, como para un beso: «uuu». ¿Dónde?", "Compara cada letra de la palabra con la U de aquí arriba.")
hints_spoken = PackedStringArray("", "", "Cuando dices la palabra, en cada U la boca se pone chiquita, como para un beso: uuuu. ¿Dónde?")
