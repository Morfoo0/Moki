[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("2_line")
text = "¡Hola otra vez! Soy Moki. Hoy vamos a conocer a la letra E."
kind = 1

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("2_line")
text = "La E suena «eee», como cuando sonríes enseñando los dientes. ¡Sonríe conmigo: eee!"
spoken = "La E suena eeee, como cuando sonríes enseñando los dientes. ¡Sonríe conmigo: eee!"
kind = 1
mood = 2

[sub_resource type="Resource" id="Resource_e3"]
script = ExtResource("2_line")
text = "La E grande tiene un palito y tres rayitas, como un peine. La e pequeñita es redondita."
kind = 1

[sub_resource type="Resource" id="Resource_e4"]
script = ExtResource("2_line")
text = "Yo te digo qué hacer y tú tocas la respuesta. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_e5"]
script = ExtResource("2_line")
text = "La E está en muchas cosas: en las estrellas del cielo, en el elefante del zoológico y en el elote que comes."
kind = 2

[sub_resource type="Resource" id="Resource_e6"]
script = ExtResource("2_line")
text = "¡Lo hiciste genial! Ya conoces mejor a la letra E. Cuando quieras, te espera la letra I."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_e7"]
script = ExtResource("2_line")
text = "¡Qué bien aprendes! La E ya es tu amiga. ¡La I tiene muchas ganas de conocerte!"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_e8"]
script = ExtResource("2_line")
text = "¡Bravo! Hoy practicaste mucho con la letra E. ¿Vamos después con la I?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_e9"]
script = ExtResource("5_choice")

[sub_resource type="Resource" id="Resource_e10"]
script = ExtResource("4_tpl")
id = &"e_pick"
title = "Toca la E"
instruction = "Toca la letra E."
hints = PackedStringArray("Busca la letra que suena «eee», como cuando sonríes enseñando los dientes.", "La E tiene un palito y tres rayitas hacia un lado, como un peine.", "Adivina, adivinanza: tengo un palito y tres rayitas, y parezco un peine. ¿Quién soy?", "Mira la E grande que te muestro aquí arriba. Quité algunas letras: busca una igual.")
hints_spoken = PackedStringArray("Busca la letra que suena eeee, como cuando sonríes enseñando los dientes.")
generator = SubResource("Resource_e9")

[sub_resource type="Resource" id="Resource_e11"]
script = ExtResource("5_choice")
mode = 4

[sub_resource type="Resource" id="Resource_e12"]
script = ExtResource("4_tpl")
id = &"e_sound"
title = "¿Qué vocal suena así?"
instruction = "Moki dice «eee». ¿Qué vocal suena así?"
instruction_spoken = "Moki dice eeee. ¿Qué vocal suena así?"
hints = PackedStringArray("Di «eee» tú también, despacito. ¿Qué vocal hace ese sonido?", "Para decir «eee» sonríes enseñando los dientes. ¿Qué vocal se dice así?", "«Elote» empieza con ese sonido: «eee». ¿Qué vocal suena al principio de elote?", "Quité algunas vocales. Di «eee» otra vez y mira las que quedan.")
hints_spoken = PackedStringArray("Di eeee tú también, despacito. ¿Qué vocal hace ese sonido?", "Para decir eeee sonríes enseñando los dientes. ¿Qué vocal se dice así?", "Elote empieza con ese sonido: eeee. ¿Qué vocal suena al principio de elote?", "Quité algunas vocales. Di eeee otra vez y mira las que quedan.")
generator = SubResource("Resource_e11")

[sub_resource type="Resource" id="Resource_e13"]
script = ExtResource("6_search")

[sub_resource type="Resource" id="Resource_e14"]
script = ExtResource("4_tpl")
id = &"e_grid"
title = "Busca todas las E"
view_type = 1
stage = 1
instruction = "Busca todas las E y tócalas una por una."
hints = PackedStringArray("Toca cada letra E que veas. ¡Puede haber varias!", "Fíjate en las letras con un palito y tres rayitas.", "La F se parece a la E, pero solo tiene dos rayitas. ¿Cuáles tienen tres?", "Compara cada letra con la E de aquí arriba. Quité algunas para que sea más fácil.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_e13")

[sub_resource type="Resource" id="Resource_e15"]
script = ExtResource("5_choice")
mode = 1

[sub_resource type="Resource" id="Resource_e16"]
script = ExtResource("4_tpl")
id = &"e_odd"
title = "¿Cuál no es E?"
stage = 1
instruction = "Todas son E menos una. ¿Cuál NO es una E?"
hints = PackedStringArray("Aquí hay muchas E vestidas de distinta forma. Una letra es diferente: ¡búscala!", "Cuenta las rayitas de cada letra: la E siempre tiene tres.", "Si todas fueran peines, ¿cuál no tendría sus tres dientes?", "Compara cada letra con la E de aquí arriba. Quité algunas E para que sea más fácil.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_e15")

[sub_resource type="Resource" id="Resource_e17"]
script = ExtResource("7_wordimg")

[sub_resource type="Resource" id="Resource_e18"]
script = ExtResource("4_tpl")
id = &"e_pick_image"
title = "¿Qué dibujo empieza con E?"
stage = 2
instruction = "¿Qué dibujo empieza con E?"
hints = PackedStringArray("Di el nombre de cada dibujo despacito. ¿Cuál empieza con «eee»?", "Escucha solo el primer sonido de cada palabra.", "«Elote» empieza con E. ¿Qué dibujo empieza igual que elote?", "Quité algunos dibujos. Mira la E de aquí arriba y di cada nombre despacito.")
hints_spoken = PackedStringArray("Di el nombre de cada dibujo despacito. ¿Cuál empieza con eeee?", "", "Elote empieza con E. ¿Qué dibujo empieza igual que elote?")
generator = SubResource("Resource_e17")

[sub_resource type="Resource" id="Resource_e19"]
script = ExtResource("7_wordimg")
mode = 1

[sub_resource type="Resource" id="Resource_e20"]
script = ExtResource("4_tpl")
id = &"e_initial"
title = "¿Con qué letra empieza?"
stage = 2
instruction = "{this_is} {article} {word}. ¿Con qué letra empieza {word}?"
hints = PackedStringArray("Di «{word}» despacito. ¿Qué sonido escuchas primero?", "El primer sonido de «{word}» es el mismo que el de «elote».", "Para decir ese primer sonido sonríes enseñando los dientes. ¿Qué letra hace ese sonido?", "Quité algunas letras para que sea más fácil. Di «{word}» otra vez, despacito.")
hints_spoken = PackedStringArray("Di {word} despacito. ¿Qué sonido escuchas primero?", "El primer sonido de {word} es el mismo que el de elote.", "", "Quité algunas letras para que sea más fácil. Di {word} otra vez, despacito.")
generator = SubResource("Resource_e19")

[sub_resource type="Resource" id="Resource_e21"]
script = ExtResource("5_choice")
mode = 2

[sub_resource type="Resource" id="Resource_e22"]
script = ExtResource("4_tpl")
id = &"e_disguised"
title = "La E disfrazada"
stage = 3
difficulty_min = 2
instruction = "Las letras se disfrazaron con otros colores y formas. ¿Puedes encontrar {letter_name}?"
hints = PackedStringArray("Aunque cambie de color o de tamaño, la E sigue siendo la E. ¡Y la e pequeñita también es E!", "No te fijes en el color: fíjate en su forma.", "Si te pones unas gafas sigues siendo tú. ¿Qué letra sigue siendo la E aunque esté disfrazada?", "Mira la letra de aquí arriba y busca la que tiene su misma forma.")
hints_spoken = PackedStringArray()
generator = SubResource("Resource_e21")

