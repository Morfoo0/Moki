[sub_resource type="Resource" id="Resource_e32"]
script = ExtResource("4_tpl")
id = &"e_mixed"
title = "Grandes y pequeñitas"
view_type = 1
stage = 4
instruction = "Busca todas las E, grandes y pequeñitas, y tócalas."
hints = PackedStringArray("Toca cada E grande y cada e pequeñita. ¡Hay de las dos!", "La E grande tiene tres rayitas; la e pequeñita es redondita, con una rayita en medio.", "La c pequeñita se parece a la e, pero no tiene rayita en medio. ¿Cuáles sí la tienen?", "Mira la E de aquí arriba. Recuerda que la e pequeñita también cuenta.")
