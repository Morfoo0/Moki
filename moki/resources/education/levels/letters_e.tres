script = ExtResource("4_tpl")
id = &"e_sort"
title = "Cesta de la E"
view_type = 2
stage = 4
instruction = "Pon en la cesta de la E los dibujos que empiezan con E. Los demás, en la otra cesta."
hints = PackedStringArray("Di el nombre de cada dibujo. Si empieza con «eee», va con la E.", "Escucha solo el primer sonido de cada palabra.", "«Elote» empieza con E, «mesa» no. ¿Qué dibujos suenan como elote al principio?", "Mira la E de la cesta y di cada nombre despacito.")
hints_spoken = PackedStringArray("Di el nombre de cada dibujo. Si empieza con eeee, va con la E.", "", "Elote empieza con E, mesa no. ¿Qué dibujos suenan como elote al principio?")
