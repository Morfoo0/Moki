script = ExtResource("4_tpl")
id = &"e_hidden"
title = "La E escondida"
view_type = 1
stage = 3
instruction = "¡La letra E se escondió entre los juguetes! Encuentra todas las E."
hints = PackedStringArray("Busca entre los dibujos una letra que sea E.", "La E tiene un palito y tres rayitas hacia un lado, como un peine.", "Soy una letra con tres rayitas, como un peine, y me escondí entre los juguetes. ¿Me ves?", "Quité algunas cosas para que sea más fácil. Compara con la E de aquí arriba.")
hints_spoken = PackedStringArray()
