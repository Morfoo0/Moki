[resource]
script = ExtResource("3_level")
id = &"letters_e"
title = "La letra E"
objective = "Reconocer la vocal E (mayúscula y minúscula), distinguirla de otras letras, identificar su sonido «eee», asociarla con palabras que empiezan con E y encontrarla en distintos contextos."
concept_ids = Array[StringName]([&"letter_e"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_e1"), SubResource("Resource_e2"), SubResource("Resource_e3"), SubResource("Resource_e4"), SubResource("Resource_e5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_e6"), SubResource("Resource_e7"), SubResource("Resource_e8")])
reinforce_lines = PackedStringArray("La E suena «eee».", "La E tiene tres rayitas, como un peine.", "¡Con la E se sonríe: eee!")
templates = Array[ExtResource("4_tpl")]([SubResource("Resource_e10"), SubResource("Resource_e12"), SubResource("Resource_e14"), SubResource("Resource_e16"), SubResource("Resource_e18"), SubResource("Resource_e20"), SubResource("Resource_e22"), SubResource("Resource_e24"), SubResource("Resource_e26"), SubResource("Resource_e28"), SubResource("Resource_e30"), SubResource("Resource_e32")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"letters_i"])
