[sub_resource type="Resource" id="Resource_e24"]
script = ExtResource("4_tpl")
id = &"e_word"
title = "Las E de la palabra"
view_type = 1
stage = 3
instruction = "Esta palabra es {word}. Toca todas las E que tiene."
hints = PackedStringArray("Mira las letras de la palabra una por una y toca las E.", "Busca las letras con un palito y tres rayitas.", "Cuando dices la palabra, en cada E sonríes un poquito: «eee». ¿Dónde sonríes?", "Compara cada letra de la palabra con la E de aquí arriba.")
hints_spoken = PackedStringArray("", "", "Cuando dices la palabra, en cada E sonríes un poquito: eeee. ¿Dónde sonríes?")
generator = SubResource("Resource_e23")

