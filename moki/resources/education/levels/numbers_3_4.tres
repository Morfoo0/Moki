[sub_resource type="Resource" id="Resource_numbers_3_4_1"]
script = ExtResource("2_line")
text = "¡Hola otra vez! Soy Moki. Ya conoces al 1 y al 2. Hoy conoceremos al 3 y al 4."
kind = 1

[sub_resource type="Resource" id="Resource_numbers_3_4_2"]
script = ExtResource("2_line")
text = "El 3 tiene dos pancitas abiertas hacia un lado. El 4 parece una sillita al revés."
kind = 1

[sub_resource type="Resource" id="Resource_numbers_3_4_3"]
script = ExtResource("2_line")
text = "Un triciclo tiene 3 ruedas y un perrito tiene 4 patas. ¡Cuéntalas: uno, dos, tres, cuatro!"
kind = 2
mood = 2

[sub_resource type="Resource" id="Resource_numbers_3_4_4"]
script = ExtResource("2_line")
text = "Para contar, toca cada cosa con tu dedo, una sola vez, y di los números en orden."

[sub_resource type="Resource" id="Resource_numbers_3_4_5"]
script = ExtResource("2_line")
text = "También vamos a repasar el 1 y el 2. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_numbers_3_4_6"]
script = ExtResource("2_line")
text = "¡Genial! Ya cuentas hasta 4. Cuando quieras, te esperan el 5 y el 6."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_numbers_3_4_7"]
script = ExtResource("2_line")
text = "¡Qué bien! El 3 y el 4 ya son tus amigos. ¿Vamos después con el 5 y el 6?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_numbers_3_4_8"]
script = ExtResource("2_line")
text = "¡Bravo! Contaste muy bien: uno, dos, tres, cuatro. ¡El 5 y el 6 te esperan!"
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"numbers_3_4"
title = "Los números 3 y 4"
objective = "Reconocer los números 3 y 4, contar hasta cuatro, asociar número y cantidad, comparar grupos pequeños, completar secuencias y repasar el 1 y el 2."
concept_ids = Array[StringName]([&"numbers_3_4"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_numbers_3_4_1"), SubResource("Resource_numbers_3_4_2"), SubResource("Resource_numbers_3_4_3"), SubResource("Resource_numbers_3_4_4"), SubResource("Resource_numbers_3_4_5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_numbers_3_4_6"), SubResource("Resource_numbers_3_4_7"), SubResource("Resource_numbers_3_4_8")])
reinforce_lines = PackedStringArray("El 3 son tres cosas, como las ruedas de un triciclo.", "El 4 son cuatro cosas, como las patas de un perrito.", "¡Contaste sin saltarte ninguno!")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_num_match"), ExtResource("t_num_name"), ExtResource("t_num_grid"), ExtResource("t_num_odd"), ExtResource("t_num_count"), ExtResource("t_num_find_group"), ExtResource("t_num_count_tap"), ExtResource("t_num_hidden"), ExtResource("t_num_sequence"), ExtResource("t_num_compare"), ExtResource("t_num_order"), ExtResource("t_num_sort")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"numbers_5_6"])
