[sub_resource type="Resource" id="Resource_shapes_oval_1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. Hoy conoceremos al óvalo y repasaremos todas las figuras."
kind = 1

[sub_resource type="Resource" id="Resource_shapes_oval_2"]
script = ExtResource("2_line")
text = "El óvalo es redondo, pero alargado, como un huevo. No tiene esquinas."
kind = 1

[sub_resource type="Resource" id="Resource_shapes_oval_3"]
script = ExtResource("2_line")
text = "El círculo es igual de ancho que de alto. El óvalo está estirado. ¡Míralos bien!"
kind = 1
mood = 3

[sub_resource type="Resource" id="Resource_shapes_oval_4"]
script = ExtResource("2_line")
text = "Hay óvalos en un huevo, en un espejo, en un limón y en un balón de fútbol americano."
kind = 2

[sub_resource type="Resource" id="Resource_shapes_oval_5"]
script = ExtResource("2_line")
text = "Hoy veremos las cinco figuras: círculo, cuadrado, triángulo, rectángulo y óvalo. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_shapes_oval_6"]
script = ExtResource("2_line")
text = "¡Lo lograste! Ya conoces las cinco figuras: círculo, cuadrado, triángulo, rectángulo y óvalo."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_shapes_oval_7"]
script = ExtResource("2_line")
text = "¡Qué orgulloso estoy de ti! Encuentras figuras en todas partes. ¡Eres un gran observador!"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_shapes_oval_8"]
script = ExtResource("2_line")
text = "¡Bravo! Círculo, cuadrado, triángulo, rectángulo y óvalo. Puedes volver a jugar con las figuras cuando quieras."
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"shapes_oval"
title = "El óvalo y repaso"
objective = "Reconocer el óvalo, distinguirlo del círculo, encontrarlo en objetos y consolidar las cinco figuras: reconocerlas, compararlas, clasificarlas y encontrarlas en dibujos."
concept_ids = Array[StringName]([&"shapes_oval"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_shapes_oval_1"), SubResource("Resource_shapes_oval_2"), SubResource("Resource_shapes_oval_3"), SubResource("Resource_shapes_oval_4"), SubResource("Resource_shapes_oval_5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_shapes_oval_6"), SubResource("Resource_shapes_oval_7"), SubResource("Resource_shapes_oval_8")])
reinforce_lines = PackedStringArray("El óvalo es redondo pero alargado.", "El círculo es igual de ancho que de alto.", "¡Ya conoces las cinco figuras!")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_sh_pick"), ExtResource("t_sh_match"), ExtResource("t_sh_grid"), ExtResource("t_sh_odd"), ExtResource("t_sh_twins"), ExtResource("t_sh_object"), ExtResource("t_sh_object_shape"), ExtResource("t_sh_find_objects"), ExtResource("t_sh_scene"), ExtResource("t_sh_corners"), ExtResource("t_sh_sort_objects"), ExtResource("t_sh_sort_shapes")])
content = ExtResource("1_bank")
