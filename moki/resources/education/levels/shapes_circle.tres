[ext_resource type="Script" path="res://scripts/education/dialogue_line.gd" id="2_line"]
[ext_resource type="Script" path="res://scripts/education/level_definition.gd" id="3_level"]
[ext_resource type="Script" path="res://scripts/education/activity_template.gd" id="4_tpl"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_pick.tres" id="t_sh_pick"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_match.tres" id="t_sh_match"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_grid.tres" id="t_sh_grid"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_odd.tres" id="t_sh_odd"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_object.tres" id="t_sh_object"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_object_shape.tres" id="t_sh_object_shape"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_find_objects.tres" id="t_sh_find_objects"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_scene.tres" id="t_sh_scene"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_sort_objects.tres" id="t_sh_sort_objects"]
[ext_resource type="Resource" path="res://resources/education/templates/shapes/sh_sort_shapes.tres" id="t_sh_sort_shapes"]

[sub_resource type="Resource" id="Resource_shapes_circle_1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. ¡Bienvenido al mundo de las figuras! Hoy conoceremos al círculo."
kind = 1

[sub_resource type="Resource" id="Resource_shapes_circle_2"]
script = ExtResource("2_line")
text = "El círculo es redondo, como una rueda. No tiene esquinas: ¡pasa tu dedo por su borde y nunca se detiene!"
kind = 1

[sub_resource type="Resource" id="Resource_shapes_circle_3"]
script = ExtResource("2_line")
text = "Hay círculos en muchas cosas: en una pelota, en una galleta, en un reloj y en las ruedas de un carro."
kind = 2
mood = 2

[sub_resource type="Resource" id="Resource_shapes_circle_4"]
script = ExtResource("2_line")
text = "Puede ser grande o pequeño, rojo o azul: si es redondo como una rueda, es un círculo."
kind = 1

[sub_resource type="Resource" id="Resource_shapes_circle_5"]
script = ExtResource("2_line")
text = "Yo te digo qué hacer y tú tocas la respuesta. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_shapes_circle_6"]
script = ExtResource("2_line")
text = "¡Muy bien! Ya conoces al círculo, redondo como una rueda. Cuando quieras, te espera el cuadrado."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_shapes_circle_7"]
script = ExtResource("2_line")
text = "¡Qué bien observas! Encontraste círculos por todas partes. ¿Vamos después con el cuadrado?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_shapes_circle_8"]
script = ExtResource("2_line")
text = "¡Bravo! El círculo ya es tu amigo. ¡El cuadrado tiene ganas de conocerte!"
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"shapes_circle"
title = "El círculo"
objective = "Reconocer el círculo, su nombre y su forma redonda sin esquinas, en distintos tamaños y colores, y encontrarlo en objetos cotidianos y en dibujos."
concept_ids = Array[StringName]([&"shapes_circle"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_shapes_circle_1"), SubResource("Resource_shapes_circle_2"), SubResource("Resource_shapes_circle_3"), SubResource("Resource_shapes_circle_4"), SubResource("Resource_shapes_circle_5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_shapes_circle_6"), SubResource("Resource_shapes_circle_7"), SubResource("Resource_shapes_circle_8")])
reinforce_lines = PackedStringArray("El círculo es redondo y no tiene esquinas.", "¡Redondo como una rueda!", "Grande o pequeño, sigue siendo un círculo.")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_sh_pick"), ExtResource("t_sh_match"), ExtResource("t_sh_grid"), ExtResource("t_sh_odd"), ExtResource("t_sh_object"), ExtResource("t_sh_object_shape"), ExtResource("t_sh_find_objects"), ExtResource("t_sh_scene"), ExtResource("t_sh_sort_objects"), ExtResource("t_sh_sort_shapes")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"shapes_square"])
