[sub_resource type="Resource" id="Resource_shapes_rectangle_1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. Hoy conoceremos al rectángulo."
kind = 1

[sub_resource type="Resource" id="Resource_shapes_rectangle_2"]
script = ExtResource("2_line")
text = "El rectángulo tiene 4 esquinas y 4 lados: 2 lados largos y 2 lados cortos. Los lados de enfrente miden lo mismo."
kind = 1

[sub_resource type="Resource" id="Resource_shapes_rectangle_3"]
script = ExtResource("2_line")
text = "¡No es un cuadrado! El cuadrado tiene sus 4 lados igual de largos. El rectángulo es más estirado."
kind = 1
mood = 3

[sub_resource type="Resource" id="Resource_shapes_rectangle_4"]
script = ExtResource("2_line")
text = "Hay rectángulos en una puerta, en un libro, en una barra de chocolate y en un teléfono. Pueden estar acostados o de pie."
kind = 2

[sub_resource type="Resource" id="Resource_shapes_rectangle_5"]
script = ExtResource("2_line")
text = "También repasaremos las figuras que ya conoces. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_shapes_rectangle_6"]
script = ExtResource("2_line")
text = "¡Genial! Ya sabes distinguir el rectángulo del cuadrado. Cuando quieras, te espera el óvalo."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_shapes_rectangle_7"]
script = ExtResource("2_line")
text = "¡Qué bien! 2 lados largos y 2 cortos: ¡eso es un rectángulo! ¿Vamos después con el óvalo?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_shapes_rectangle_8"]
script = ExtResource("2_line")
text = "¡Bravo! Ya conoces cuatro figuras. ¡Solo falta el óvalo!"
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"shapes_rectangle"
title = "El rectángulo"
objective = "Reconocer el rectángulo (4 esquinas, 2 lados largos y 2 cortos, lados opuestos iguales), distinguirlo del cuadrado, verlo acostado o de pie y encontrarlo en objetos y dibujos."
concept_ids = Array[StringName]([&"shapes_rectangle"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_shapes_rectangle_1"), SubResource("Resource_shapes_rectangle_2"), SubResource("Resource_shapes_rectangle_3"), SubResource("Resource_shapes_rectangle_4"), SubResource("Resource_shapes_rectangle_5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_shapes_rectangle_6"), SubResource("Resource_shapes_rectangle_7"), SubResource("Resource_shapes_rectangle_8")])
reinforce_lines = PackedStringArray("El rectángulo tiene 2 lados largos y 2 cortos.", "El cuadrado tiene sus 4 lados iguales; el rectángulo, no.", "Acostado o de pie, sigue siendo un rectángulo.")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_sh_pick"), ExtResource("t_sh_match"), ExtResource("t_sh_grid"), ExtResource("t_sh_odd"), ExtResource("t_sh_twins"), ExtResource("t_sh_object"), ExtResource("t_sh_object_shape"), ExtResource("t_sh_find_objects"), ExtResource("t_sh_scene"), ExtResource("t_sh_corners"), ExtResource("t_sh_sort_objects"), ExtResource("t_sh_sort_shapes")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"shapes_oval"])
