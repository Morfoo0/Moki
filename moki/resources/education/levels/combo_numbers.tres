[sub_resource type="Resource" id="Resource_combo_numbers_1"]
script = ExtResource("2_line")
text = "¡Hola otra vez! Soy Moki. Hoy usaremos todos los números, del 1 al 10."
kind = 1

[sub_resource type="Resource" id="Resource_combo_numbers_2"]
script = ExtResource("2_line")
text = "Contaremos animales, frutas y juguetes. Recuerda: toca cada cosa con tu dedo una sola vez."
kind = 1

[sub_resource type="Resource" id="Resource_combo_numbers_3"]
script = ExtResource("2_line")
text = "Los números están en todas partes: tus 10 dedos, las 4 patas de un perrito, las 2 ruedas de una bici."
kind = 2
mood = 2

[sub_resource type="Resource" id="Resource_combo_numbers_4"]
script = ExtResource("2_line")
text = "Mira con calma y cuenta despacito. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_combo_numbers_5"]
script = ExtResource("2_line")
text = "¡Genial! Contaste del 1 al 10 como un experto. Cuando quieras, te esperan las figuras y los números juntos."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_combo_numbers_6"]
script = ExtResource("2_line")
text = "¡Qué bien cuentas! Uniste números y cantidades. ¿Vamos después con las figuras?"
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_combo_numbers_7"]
script = ExtResource("2_line")
text = "¡Bravo! Los números ya no tienen secretos para ti. ¡La siguiente lección te espera!"
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"combo_numbers"
title = "Números y cantidades"
objective = "Aplicar los números del 1 al 10: reconocerlos, contar objetos, relacionar número y cantidad, comparar grupos, completar secuencias y ordenar."
concept_ids = Array[StringName]([&"combo_numbers"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_combo_numbers_1"), SubResource("Resource_combo_numbers_2"), SubResource("Resource_combo_numbers_3"), SubResource("Resource_combo_numbers_4")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_combo_numbers_5"), SubResource("Resource_combo_numbers_6"), SubResource("Resource_combo_numbers_7")])
reinforce_lines = PackedStringArray("¡Cada número dice cuántas cosas hay!", "¡Contaste sin saltarte ninguno!", "¡Del 1 al 10, muy bien!")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_num_match"), ExtResource("t_num_name"), ExtResource("t_num_grid"), ExtResource("t_num_odd"), ExtResource("t_num_count"), ExtResource("t_num_find_group"), ExtResource("t_num_count_tap"), ExtResource("t_num_hidden"), ExtResource("t_num_sequence"), ExtResource("t_num_compare"), ExtResource("t_num_order"), ExtResource("t_num_sort")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"combo_shapes"])
