[sub_resource type="Resource" id="Resource_numbers_1_2_1"]
script = ExtResource("2_line")
text = "¡Hola! Soy Moki. ¡Bienvenido al mundo de los números! Hoy conoceremos al 1 y al 2."
kind = 1

[sub_resource type="Resource" id="Resource_numbers_1_2_2"]
script = ExtResource("2_line")
text = "El 1 es un palito derechito. El 2 parece un patito nadando."
kind = 1

[sub_resource type="Resource" id="Resource_numbers_1_2_3"]
script = ExtResource("2_line")
text = "Los números nos dicen cuántas cosas hay. Tienes una nariz: ¡uno! Y tienes dos ojos: ¡dos!"
kind = 2
mood = 2

[sub_resource type="Resource" id="Resource_numbers_1_2_4"]
script = ExtResource("2_line")
text = "Para contar, toca cada cosa con tu dedo y di un número: uno, dos."

[sub_resource type="Resource" id="Resource_numbers_1_2_5"]
script = ExtResource("2_line")
text = "Yo te digo qué hacer y tú tocas la respuesta. Si necesitas ayuda, toca el botón de ayuda."

[sub_resource type="Resource" id="Resource_numbers_1_2_6"]
script = ExtResource("2_line")
text = "¡Muy bien! Ya conoces al 1 y al 2. Cuando quieras, te esperan el 3 y el 4."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_numbers_1_2_7"]
script = ExtResource("2_line")
text = "¡Qué bien cuentas! Uno, dos... Pronto conocerás al 3 y al 4."
kind = 5
mood = 2

[sub_resource type="Resource" id="Resource_numbers_1_2_8"]
script = ExtResource("2_line")
text = "¡Bravo! Hoy aprendiste que el 2 son dos cosas, como tus dos manos. ¿Vamos después con el 3 y el 4?"
kind = 5
mood = 2

[resource]
script = ExtResource("3_level")
id = &"numbers_1_2"
title = "Los números 1 y 2"
objective = "Reconocer los números 1 y 2, contar uno y dos objetos, relacionar cada número con su cantidad y distinguir una cosa de dos."
concept_ids = Array[StringName]([&"numbers_1_2"])
intro = Array[ExtResource("2_line")]([SubResource("Resource_numbers_1_2_1"), SubResource("Resource_numbers_1_2_2"), SubResource("Resource_numbers_1_2_3"), SubResource("Resource_numbers_1_2_4"), SubResource("Resource_numbers_1_2_5")])
outro = Array[ExtResource("2_line")]([SubResource("Resource_numbers_1_2_6"), SubResource("Resource_numbers_1_2_7"), SubResource("Resource_numbers_1_2_8")])
reinforce_lines = PackedStringArray("Cada número dice cuántas cosas hay.", "¡Uno, dos: así se cuenta!", "El 2 son dos cosas, como tus dos ojos.")
templates = Array[ExtResource("4_tpl")]([ExtResource("t_num_match"), ExtResource("t_num_name"), ExtResource("t_num_grid"), ExtResource("t_num_odd"), ExtResource("t_num_count"), ExtResource("t_num_find_group"), ExtResource("t_num_count_tap"), ExtResource("t_num_hidden"), ExtResource("t_num_compare"), ExtResource("t_num_order"), ExtResource("t_num_sort")])
content = ExtResource("1_bank")
unlocks = Array[StringName]([&"numbers_3_4"])
